{
  "name": "bb-plugin-studio",
  "version": "0.1.0-alpha.3",
  "description": "Build, inspect, and preview bb plugins.",
  "homepage": "https://github.com/galligan/bb-plugin-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galligan/bb-plugin-studio.git",
    "directory": "plugins/studio"
  },
  "bugs": {
    "url": "https://github.com/galligan/bb-plugin-studio/issues"
  },
  "keywords": [
    "bb",
    "plugin-development",
    "developer-tools"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "bb-plugin-studio": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "engines": {
    "bb": ">=0.43.1",
    "bbPluginSdk": "^0.4.87"
  },
  "bb": {
    "name": "Plugin Studio",
    "description": "Build, inspect, and preview bb plugins.",
    "branding": {
      "icon": "Toolbox"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "./skills/plugin-studio"
    ]
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/cli.js",
    "dist/app.js",
    "dist/app.css",
    "dist/app.meta.json",
    "skills/plugin-studio/SKILL.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "build": "bb plugin build .",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "package:artifact": "bun ../../scripts/build-plugin-studio-package.ts",
    "test": "bun test src",
    "types": "bb plugin types .",
    "types:check": "bb plugin types . --check",
    "visual:test": "bb plugin build . && playwright test --config visual/playwright.config.ts",
    "visual:update": "bb plugin build . && playwright test --config visual/playwright.config.ts --update-snapshots=all"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@bb-plugin-studio/runtime": "workspace:*",
    "@get-bb/plugin-sdk": "0.4.87",
    "@happy-dom/global-registrator": "^18.0.1",
    "@pierre/diffs": "^1.2.9",
    "@playwright/test": "1.62.1",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/bun": "^1.3.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.43.1",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.11.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.9.2",
    "vaul": "^1.1.2",
    "vite": "^7.1.3",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@radix-ui/react-slot": "^1.3.3"
  }
}
